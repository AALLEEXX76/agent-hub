{$SITE_DOMAIN} {
    encode gzip

    # Referral Service API (public path) — must be handled before WP
    handle_path /ref/* {
        reverse_proxy referral-api:8080
    }

    # WordPress (php-fpm)
    handle {
        root * /var/www/html
        php_fastcgi wordpress:9000
        file_server
    }
}
