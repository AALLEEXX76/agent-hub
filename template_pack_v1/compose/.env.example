# Template Pack v1 — env example

# Domain & email
SITE_DOMAIN=example.ru
SITE_EMAIL=admin@example.ru

# WordPress admin
WP_ADMIN_USER=adminuser
WP_ADMIN_PASS=change-me
WP_ADMIN_EMAIL=admin@example.ru
WP_LOCALE=ru_RU

# MariaDB
DB_NAME=wpdb
DB_USER=wpuser
DB_PASS=change-me
DB_ROOT_PASS=change-me

# Modules toggles
AGEGATE_ENABLED=true
REFERRAL_ENABLED=true
YANDEX_PAY_ENABLED=false
CDEK_ENABLED=false
POST_RU_ENABLED=false

# Referral Service (same compose)
REFERRAL_STORE_API_KEY=change-me
REFERRAL_BASE_URL=http://referral-api:8080
REF_ATTR_WINDOW_DAYS=60
REF_DISCOUNT_PERCENT=5
REF_TTL_DAYS=180
REF_PAYOUT_MIN=5000
REF_HOLD_MONTHS=1

# Remote backup (optional)
REMOTE_BACKUP_ENABLED=false
REMOTE_BACKUP_HOST=
REMOTE_BACKUP_USER=
REMOTE_BACKUP_PATH=
REMOTE_BACKUP_PORT=22
